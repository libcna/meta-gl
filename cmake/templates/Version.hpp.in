/**
 * @file Version.hpp
 * @brief The meta-gl release a translation unit is compiled against.
 *
 * Generated by cmake/Version.cmake from cmake/templates/Version.hpp.in. The version itself is
 * decided in one place only -- project(meta-gl VERSION ...) and METAGL_VERSION_PRERELEASE in
 * the root CMakeLists.txt (see docs/releasing.md). Never edit the generated copy in the build
 * tree.
 *
 * This is meta-gl's own product version, deliberately independent of numbers it is easy to
 * confuse it with: the shared-library SOVERSION stays 0 for the whole pre-1.0 phase, and the
 * OpenGL / OpenGL ES version of a live context is reported at runtime by GetContextInfo() and
 * GetCapabilities().
 *
 * The object-like macros exist because a constexpr value cannot be tested by the preprocessor;
 * use them for compile-time feature gating (`#if METAGL_VERSION_MINOR >= 2`) and the functions
 * below for everything else.
 */
#pragma once

#include <string_view>

/** @brief Major component of the meta-gl release, as a preprocessor-testable integer literal. */
#define METAGL_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Minor component of the meta-gl release, as a preprocessor-testable integer literal. */
#define METAGL_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief Patch component of the meta-gl release, as a preprocessor-testable integer literal. */
#define METAGL_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief Pre-release identifier without its leading '-'; an empty string on a final release. */
#define METAGL_VERSION_PRERELEASE "@METAGL_VERSION_PRERELEASE@"

/** @brief The complete release string, e.g. "0.1.0" or "0.2.0-beta.1". */
#define METAGL_VERSION_STRING "@METAGL_VERSION_STRING@"

namespace metagl
{
    /**
     * @brief Returns the major component of the meta-gl release being compiled against.
     * @return The Semantic Versioning major component.
     */
    [[nodiscard]] constexpr int GetVersionMajor() noexcept
    {
        return METAGL_VERSION_MAJOR;
    }

    /**
     * @brief Returns the minor component of the meta-gl release being compiled against.
     * @return The Semantic Versioning minor component.
     */
    [[nodiscard]] constexpr int GetVersionMinor() noexcept
    {
        return METAGL_VERSION_MINOR;
    }

    /**
     * @brief Returns the patch component of the meta-gl release being compiled against.
     * @return The Semantic Versioning patch component.
     */
    [[nodiscard]] constexpr int GetVersionPatch() noexcept
    {
        return METAGL_VERSION_PATCH;
    }

    /**
     * @brief Returns the pre-release identifier of the meta-gl release being compiled against.
     *
     * The leading '-' is not part of the value: the release 0.2.0-beta.1 reports "beta.1".
     *
     * @return The pre-release identifier, or an empty view on a final release.
     */
    [[nodiscard]] constexpr std::string_view GetVersionPreRelease() noexcept
    {
        return METAGL_VERSION_PRERELEASE;
    }

    /**
     * @brief Returns the complete release string of the meta-gl release being compiled against.
     * @return The version in Semantic Versioning spelling, e.g. "0.1.0"; no leading 'v'.
     */
    [[nodiscard]] constexpr std::string_view GetVersionString() noexcept
    {
        return METAGL_VERSION_STRING;
    }

    /**
     * @brief Reports whether this build is a pre-release (alpha, beta or release candidate).
     * @return True when a pre-release identifier is present, false on a final release.
     */
    [[nodiscard]] constexpr bool IsPreReleaseVersion() noexcept
    {
        return !GetVersionPreRelease().empty();
    }
}
